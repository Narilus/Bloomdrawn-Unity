{
  "$schema": "https://opencode.ai/config.json",

  // Start every session in the project planning role.
  "default_agent": "bloom-planner",

  // Primary agents may delegate one bounded helper/specialist layer.
  "subagent_depth": 1,

  // Project sessions remain private unless the owner changes this deliberately.
  "share": "disabled",

  "agent": {
    // Remove unrestricted write-capable escape hatches.
    "build": {
      "disable": true
    },
    "general": {
      "disable": true
    },

    // Lightweight read-only helpers remain inside the GPT-5.6 family.
    "explore": {
      "model": "openai/gpt-5.6-luna",
      "reasoningEffort": "low",
      "textVerbosity": "low"
    },
    "scout": {
      "model": "openai/gpt-5.6-luna",
      "reasoningEffort": "low",
      "textVerbosity": "low"
    }
  }
}
